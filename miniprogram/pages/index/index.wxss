.container {
  padding: 32rpx;
  padding-bottom: 80rpx;
}

/* Header */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.logo {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #07c160;
  letter-spacing: 2rpx;
}

.logo-badge {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
}

.subtitle {
  font-size: 26rpx;
  color: #6b7280;
}

/* Main Card */
.main-card {
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}

.icon-wrap {
  margin-bottom: 24rpx;
}

.icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.icon-emoji {
  font-size: 56rpx;
}

.action-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.action-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* Progress */
.progress-section {
  background: #f0fdf4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.progress-count {
  font-weight: 700;
  color: #07c160;
  font-size: 28rpx;
}

.progress-bar {
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #2f9e6e);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 10rpx;
}

.progress-hint.done {
  color: #07c160;
  font-weight: 600;
}

/* Watch Button */
.watch-btn {
  width: 100%;
  font-size: 34rpx;
  padding: 28rpx 0;
}

/* Test Button */
.btn-test {
  width: 100%;
  margin-top: 16rpx;
  background: transparent;
  color: #9ca3af;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.btn-test[disabled] {
  color: #d1d5db;
}

/* Steps Card */
.steps-card {
  margin-bottom: 32rpx;
}

.steps-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #1a1a1a;
}

.step-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 28rpx;
  color: #374151;
}

/* Website Section */
.website-section {
  text-align: center;
  padding: 24rpx;
}

.website-label {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 8rpx;
}

.website-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
  padding: 12rpx 32rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #d1fae5;
}

.copy-icon {
  font-size: 28rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx;
  width: 86%;
  max-width: 640rpx;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: #9ca3af;
  padding: 8rpx;
  line-height: 1;
}

/* Result */
.result-section {
  margin-bottom: 32rpx;
}

.result-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.code-box.membership-box {
  background: #fef3c7;
  border-color: #f59e0b;
}

.code-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}

.membership-box .code-text {
  color: #d97706;
}

.copy-btn {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 2rpx solid #07c160;
}

.membership-hint {
  font-size: 24rpx;
  color: #d97706;
  margin-top: 12rpx;
  text-align: center;
}

/* Modal Footer */
.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.modal-footer button {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
}
